TELEGRAM_BOT_TOKEN=your-bot-token-here
# OPENAI_API_KEY is for Whisper transcription ONLY — never used for Codex AI calls
OPENAI_API_KEY=your-openai-api-key-here

# Comma-separated Telegram user IDs that are authorized without /pair.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with preconfigured admin access.
TELEGRAM_ADMIN_USER_IDS=

# Required only when [api].enabled = true. Use this bearer token from a trusted
# server-side caller; do not expose codex-chat directly to browsers.
CODEX_CHAT_API_TOKEN=
