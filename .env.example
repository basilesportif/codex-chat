TELEGRAM_BOT_TOKEN=your-bot-token-here
# OPENAI_API_KEY is used only by the feature-flagged OpenAI regular-transcription
# rollback path and the preserved diarization provider. Codex app-server
# regular transcription uses ChatGPT login and does not inherit this key.
OPENAI_API_KEY=your-openai-api-key-here

# Main-loop provider. The default remains codex.
# CODEX_CHAT_MAIN_PROVIDER=codex
# Claude main-loop settings. Model may be an alias (for example `sonnet`) or a
# full Claude model ID. This provider requires Claude subscription OAuth from
# `claude auth login` run as the service user. Restart after changing provider;
# rollback by setting CODEX_CHAT_MAIN_PROVIDER=codex and restarting.
# CODEX_CHAT_MAIN_CLAUDE_MODEL=claude-sonnet-5
# CODEX_CHAT_MAIN_CLAUDE_EFFORT=high
# CODEX_CHAT_MAIN_CLAUDE_PERMISSION_MODE=bypassPermissions
# CODEX_CHAT_MAIN_CLAUDE_ALLOWED_TOOLS=Read,Write,Edit,MultiEdit,Bash,Glob,Grep,Agent
# CODEX_CHAT_MAIN_CLAUDE_DISALLOWED_TOOLS=

# Regular voice/audio transcription provider. codex_app_server requires Codex
# CLI >=0.145.0; switch back to openai for rollback. Diarization remains OpenAI.
CODEX_CHAT_TRANSCRIPTION_PROVIDER=openai
CODEX_CHAT_TRANSCRIPTION_APP_SERVER_MODEL=
CODEX_CHAT_TRANSCRIPTION_APP_SERVER_EFFORT=medium
CODEX_CHAT_TRANSCRIPTION_APP_SERVER_TIMEOUT_SEC=180

# Main-loop Codex app-server model/provider selectors. These override [codex]
# in config/codex-chat.toml and require a codex-chat.service restart. Leave
# profile/provider empty for the normal Codex/OpenAI subscription. For
# OpenRouter GLM 5.2 use model z-ai/glm-5.2, profile openrouter, provider
# openrouter, and tier mode omit.
CODEX_CHAT_CODEX_MODEL=gpt-5.6-luna
CODEX_CHAT_CODEX_EFFORT=xhigh
CODEX_CHAT_CODEX_PROFILE=
CODEX_CHAT_CODEX_MODEL_PROVIDER=
CODEX_CHAT_CODEX_SERVICE_TIER=fast
CODEX_CHAT_CODEX_SERVICE_TIER_MODE=auto

# Routine/non-coding subagent fallback. Coding routes choose gpt-5.6-sol with
# high effort explicitly according to behavior/AGENTS.md.
CODEX_CHAT_SUBAGENTS_DEFAULT_MODEL=gpt-5.6-luna

# Claude SDK native nested-agent model overrides (aliases or full model IDs).
# CODEX_CHAT_SUBAGENTS_CLAUDE_IMPLEMENTER_MODEL=sonnet
# CODEX_CHAT_SUBAGENTS_CLAUDE_INVESTIGATOR_MODEL=sonnet
# CODEX_CHAT_SUBAGENTS_CLAUDE_REVIEWER_MODEL=claude-opus-5

# Comma-separated Telegram user IDs that are authorized without /pair.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with preconfigured admin access.
TELEGRAM_ADMIN_USER_IDS=

# Slack Events API signing secret and bot token. Optional unless [slack]
# enabled=true. Keep raw values in service env only; never commit them.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Read-only Brain capability identity/grant store used for fail-closed Slack
# runtime authorization. Telegram enforcement is not connected yet.
BRAIN_CAPABILITY_STORE_PATH=/home/tim/.brain/control-plane/capabilities.json

# Audio ingestion endpoint keys. Comma/newline-separated; optional labels use
# label:secret and are logged as labels, never as raw keys.
CODEXCHAT_INGEST_API_KEYS=

# Max accepted audio upload size for /api/ingest/audio.
CODEXCHAT_AUDIO_INGEST_MAX_MB=100

# Public origins. CODEX_CHAT_BASE_URL is for Slack Events;
# CODEX_CHAT_ADMIN_PUBLIC_BASE_URL is for the Clerk-protected admin page.
CODEX_CHAT_BASE_URL=https://brain.decisive-outcomes.com
CODEX_CHAT_ADMIN_PUBLIC_BASE_URL=https://brain.decisive-outcomes.com
# Optional authoritative IANA timezone for user-relative dates and child processes.
# CODEX_CHAT_TIMEZONE=America/New_York
