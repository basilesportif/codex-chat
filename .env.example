TELEGRAM_BOT_TOKEN=your-bot-token-here
# OPENAI_API_KEY is for service-side OpenAI transcription ONLY — never used for Codex AI calls
OPENAI_API_KEY=your-openai-api-key-here

# Comma-separated Telegram user IDs that are authorized without /pair.
TELEGRAM_ALLOWED_USER_IDS=

# Comma-separated Telegram user IDs with preconfigured admin access.
TELEGRAM_ADMIN_USER_IDS=

# Slack Events API signing secret and bot token. Optional unless [slack]
# enabled=true. Keep raw values in service env only; never commit them.
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Read-only Brain capability identity/grant store used for fail-closed Slack
# runtime authorization. Telegram enforcement is not connected yet.
BRAIN_CAPABILITY_STORE_PATH=/home/tim/.brain/control-plane/capabilities.json

# Audio ingestion endpoint keys. Comma/newline-separated; optional labels use
# label:secret and are logged as labels, never as raw keys.
CODEXCHAT_INGEST_API_KEYS=

# Max accepted audio upload size for /api/ingest/audio.
CODEXCHAT_AUDIO_INGEST_MAX_MB=100

# Public origins. CODEX_CHAT_BASE_URL is for Slack Events;
# CODEX_CHAT_ADMIN_PUBLIC_BASE_URL is for the Clerk-protected admin page.
CODEX_CHAT_BASE_URL=https://brain.decisive-outcomes.com
CODEX_CHAT_ADMIN_PUBLIC_BASE_URL=https://brain.decisive-outcomes.com
