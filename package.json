{
  "name": "codex-chat",
  "version": "0.1.0",
  "description": "Telegram-driven Codex service with subagent, loop, and monitor support.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "files": [
    ".env.example",
    "behavior/",
    "config/*.example.json",
    "config/*.example.toml",
    "dist/",
    "scripts/"
  ],
  "bin": {
    "codex-chat": "dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",
    "dev": "bun run src/main.ts",
    "test": "vitest run",
    "backup:child-vocab-srs": "node scripts/child-vocab-srs-backup.mjs",
    "start": "bun dist/main.js start",
    "health": "bun dist/main.js health"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "commander": "^14.0.1",
    "cron-parser": "^5.4.0",
    "grammy": "^1.38.3",
    "openai": "^6.6.0",
    "pino": "^10.0.0",
    "smol-toml": "^1.4.2",
    "ws": "^8.18.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
