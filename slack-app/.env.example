# Copy the values from the installed Slack app into the service environment.
# Do not commit real values.

# Basic Information > App Credentials > Signing Secret
SLACK_SIGNING_SECRET=

# OAuth & Permissions > Bot User OAuth Token (xoxb-...)
SLACK_BOT_TOKEN=

# Socket Mode is disabled in slack-app/manifest.json for the Phase 2 HTTP Events API path.
# Leave this blank unless a future adapter enables Socket Mode with an app-level xapp token.
SLACK_APP_TOKEN=

# Enables the codex-chat Slack adapter. Also enables the HTTP API listener.
CODEX_CHAT_SLACK_ENABLED=true
CODEX_CHAT_SLACK_EVENTS_PATH=/api/slack/events
CODEX_CHAT_BASE_URL=https://me.galebach.com
CODEX_CHAT_ADMIN_PUBLIC_BASE_URL=https://brain.decisive-outcomes.com

# Enables the initial codex-chat admin page at /admin/codex-chat/.
CODEX_CHAT_ADMIN_ENABLED=true
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=
CLERK_ALLOWED_EMAILS=timgalebachukraine@gmail.com,tim.galebach@gmail.com

# If the Events API request URL is served by this codex-chat process, configure
# the HTTP API listener in config/codex-chat.toml or through env overrides.
CODEX_CHAT_API_ENABLED=true
# CODEX_CHAT_API_HOST=127.0.0.1
# CODEX_CHAT_API_PORT=49346
