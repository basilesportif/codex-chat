{
  "display_information": {
    "name": "Brain",
    "description": "Company-brain Slack surface for Brain.",
    "background_color": "#1d1c1d"
  },
  "features": {
    "bot_user": {
      "display_name": "Brain",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": [
        "app_mentions:read",
        "channels:history",
        "channels:read",
        "chat:write",
        "groups:history",
        "groups:read",
        "im:history",
        "im:read",
        "mpim:history",
        "mpim:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://YOUR-BRAIN-HOST.example.com/api/slack/events",
      "bot_events": [
        "app_mention",
        "message.groups",
        "message.im",
        "message.mpim"
      ]
    },
    "interactivity": {
      "is_enabled": false
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
